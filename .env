# .env

# Gate Configuration
GATE_CODE=GATE01

# API Configuration
API_BASE_URL=https://siphonlike-uncourtly-jimmy.ngrok-free.dev

# Serial Configuration - PORT SAMA untuk sensor dan barrier
SERIAL_PORT=/dev/ttyUSB0
BAUDRATE=9600

# Barrier Gate Configuration - Gunakan PORT yang SAMA!
BARRIER_PORT=/dev/ttyUSB0
BARRIER_BAUDRATE=9600
BARRIER_OPEN_DURATION=3.0

# Barrier pulse configuration (if needed)
BARRIER_PULSES=10
BARRIER_DELAY=0.1

# Sound files
SOUND_UNPAID=sounds/unpaid.mp3
SOUND_SUCCESS=sounds/success.mp3
SOUND_ERROR=sounds/error.mp3
SOUND_DETECT=sounds/detect.mp3

# Printer Configuration
PRINTER_NAME=EPSON TM-T82II

# Pusher Configuration
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=ap1

# Timeouts
API_TIMEOUT=30